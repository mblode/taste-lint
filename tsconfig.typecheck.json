{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "scripts/**/*.ts", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "dist", "src/__tests__/fixtures/**"]
}
