{
  "name": "taste-lint",
  "version": "0.3.0",
  "description": "Taste linter: copy and typography rules from agent-skills answered by TypeSafe Jev probabilities, with mechanical checks, calibration and a scorecard",
  "keywords": [
    "copywriting",
    "design",
    "jev",
    "lint",
    "taste",
    "typesafe",
    "typography"
  ],
  "homepage": "https://blode.co/taste-lint",
  "bugs": {
    "url": "https://github.com/mblode/taste-lint/issues"
  },
  "license": "MIT",
  "author": "Matthew Blode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/taste-lint.git"
  },
  "bin": {
    "taste-lint": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "data"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "cd ../.. && tsdown && node scripts/stage-package.mjs",
    "dev": "cd ../.. && tsdown --watch",
    "typecheck": "cd ../.. && tsc -p tsconfig.typecheck.json",
    "test": "cd ../.. && vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "oxc-parser": "^0.151.0",
    "parse5": "^8.0.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.11"
  }
}
