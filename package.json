{
  "name": "taste-lint-repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "node dist/cli.js",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "npm run build && changeset publish",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "node scripts/prepare.mjs",
    "test:package": "node scripts/test-package.mjs",
    "port-rules": "node --experimental-strip-types scripts/port-rules.ts",
    "seed-corpus": "npm run build && node --experimental-strip-types scripts/seed-corpus.ts",
    "verify": "npm run check && npm run build && npm run typecheck && npm test && npm run test:package",
    "verify:full": "npm run verify && node dist/cli.js rules check && npm run taste",
    "build:cli": "turbo run build --filter=taste-lint",
    "build:web": "turbo run build --filter=@taste-lint/web",
    "dev:cli": "turbo run dev --filter=taste-lint",
    "dev:web": "turbo run dev --filter=@taste-lint/web",
    "typecheck:cli": "turbo run typecheck --filter=taste-lint",
    "test:cli": "turbo run test --filter=taste-lint",
    "check:web": "npm run typecheck --workspace @taste-lint/web && npm run test --workspace @taste-lint/web",
    "taste": "node dist/cli.js lint --profile all --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tsdown": "^0.22.5",
    "turbo": "^2.8.0",
    "typescript": "7.0.2",
    "ultracite": "7.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "npm@11.19.0"
}
