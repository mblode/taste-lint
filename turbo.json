{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/docs.json",
        "$TURBO_ROOT$/docs/*.mdx"
      ]
    },
    "typecheck": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/docs.json"]
    },
    "test": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/docs.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "taste-lint#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/data/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tsdown.config.ts",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/LICENSE.md"
      ],
      "outputs": [
        "dist/**",
        "data/**",
        "README.md",
        "LICENSE.md",
        "$TURBO_ROOT$/dist/**"
      ]
    },
    "taste-lint#test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "taste-lint#typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/data/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tsdown.config.ts",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/LICENSE.md"
      ],
      "outputs": []
    }
  }
}
