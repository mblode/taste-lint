{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "taste-lint rule",
  "description": "Editor completion only. The source of truth is src/rules/validate.ts. Tier, domain and (for every unit but source) scope are derived, not written.",
  "type": "object",
  "required": [
    "id",
    "title",
    "categoryId",
    "source",
    "unit",
    "severity",
    "fix"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "categoryId": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": ["repo", "path"],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "ruleId": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unit": {
      "type": "array",
      "items": {
        "enum": [
          "paragraph",
          "heading",
          "jsx-text",
          "attr-string",
          "class-list",
          "element",
          "source"
        ]
      }
    },
    "mechanical": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["regex"]
        },
        {
          "required": ["phrases"]
        }
      ],
      "properties": {
        "regex": {
          "type": "string"
        },
        "flags": {
          "type": "string"
        },
        "phrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minMatches": {
          "type": "integer",
          "minimum": 1
        },
        "absent": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["instructions"],
      "additionalProperties": false,
      "properties": {
        "instructions": {
          "type": "string"
        },
        "context": {
          "type": "array",
          "items": {
            "enum": [
              "headingAbove",
              "docType",
              "element",
              "role",
              "neighbours",
              "writingFacts",
              "writingProfile",
              "writingInstructions",
              "section",
              "earlier",
              "brief"
            ]
          }
        },
        "criteria": {
          "type": "object",
          "required": ["true", "false"],
          "properties": {
            "true": {
              "$ref": "#/$defs/side"
            },
            "false": {
              "$ref": "#/$defs/side"
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "act": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "severity": {
      "enum": ["major", "minor"]
    },
    "fix": {
      "type": "object",
      "required": ["hint"],
      "additionalProperties": false,
      "properties": {
        "hint": {
          "type": "string"
        },
        "function": {
          "type": "string"
        }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notInCode": {
          "const": true
        },
        "docType": {
          "type": "array",
          "items": {
            "enum": [
              "tutorial",
              "howto",
              "reference",
              "explanation",
              "agent-instructions",
              "lesson",
              "marketing",
              "ui",
              "readme",
              "skill",
              "plan",
              "unknown"
            ]
          }
        },
        "role": {
          "type": "array",
          "items": {
            "enum": [
              "heading",
              "body",
              "list-item",
              "cell",
              "button",
              "link",
              "label",
              "placeholder",
              "aria",
              "literal-copy",
              "caption",
              "unknown"
            ]
          }
        },
        "smartQuotesAtBuild": {
          "const": false
        },
        "minWords": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "status": {
      "enum": ["active", "draft", "review-only"]
    },
    "handWritten": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "exceptions", "evidence", "verification"],
      "properties": {
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "exceptions": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "side": {
      "type": "object",
      "required": ["what", "examples"],
      "properties": {
        "what": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}
