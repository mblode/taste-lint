{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "slop-cop rule",
  "description": "Editor completion only. The source of truth is src/rules/validate.ts.",
  "type": "object",
  "required": [
    "id",
    "title",
    "categoryId",
    "domain",
    "source",
    "scope",
    "unit",
    "tier",
    "severity",
    "fix"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string" },
    "categoryId": { "type": "string" },
    "domain": {
      "enum": [
        "typography",
        "craft",
        "copywriting",
        "interaction",
        "motion",
        "product"
      ]
    },
    "source": {
      "type": "object",
      "required": ["repo", "path"],
      "properties": {
        "repo": { "type": "string" },
        "path": { "type": "string" },
        "line": { "type": "integer" },
        "ruleId": { "type": "string" },
        "tier": { "type": "string" }
      }
    },
    "related": { "type": "array", "items": { "type": "string" } },
    "scope": {
      "type": "object",
      "required": ["include"],
      "properties": {
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "unit": {
      "type": "array",
      "items": {
        "enum": [
          "paragraph",
          "heading",
          "jsx-text",
          "attr-string",
          "class-list",
          "element",
          "file"
        ]
      }
    },
    "tier": { "enum": ["mechanical", "jev", "both"] },
    "mechanical": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["regex"] }, { "required": ["phrases"] }],
      "properties": {
        "regex": { "type": "string" },
        "flags": { "type": "string" },
        "phrases": { "type": "array", "items": { "type": "string" } },
        "minMatches": { "type": "integer", "minimum": 1 },
        "absent": { "type": "string" }
      }
    },
    "question": {
      "type": "object",
      "required": ["type", "instructions"],
      "properties": {
        "type": { "const": "noul" },
        "instructions": { "type": "string" },
        "context": {
          "type": "array",
          "items": {
            "enum": ["headingAbove", "docType", "element", "role", "neighbours"]
          }
        },
        "criteria": {
          "type": "object",
          "required": ["true", "false"],
          "properties": {
            "true": { "$ref": "#/$defs/side" },
            "false": { "$ref": "#/$defs/side" }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review": { "type": "number", "minimum": 0, "maximum": 1 },
        "act": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "severity": { "enum": ["critical", "major", "minor"] },
    "severityOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "severity"],
        "properties": {
          "scope": { "type": "string" },
          "severity": { "enum": ["critical", "major", "minor"] }
        }
      }
    },
    "fix": {
      "type": "object",
      "required": ["mode", "hint"],
      "properties": {
        "mode": { "enum": ["deterministic", "llm", "none"] },
        "hint": { "type": "string" },
        "function": { "type": "string" }
      }
    },
    "preconditions": {
      "type": "object",
      "properties": {
        "notInCode": { "const": true },
        "docType": {
          "type": "array",
          "items": {
            "enum": [
              "tutorial",
              "howto",
              "reference",
              "explanation",
              "agent-instructions",
              "lesson",
              "marketing",
              "ui",
              "unknown"
            ]
          }
        },
        "role": {
          "type": "array",
          "items": {
            "enum": [
              "heading",
              "body",
              "list-item",
              "cell",
              "button",
              "link",
              "label",
              "placeholder",
              "aria",
              "literal-copy",
              "caption",
              "unknown"
            ]
          }
        },
        "element": { "type": "array", "items": { "type": "string" } },
        "smartQuotesAtBuild": { "const": false }
      }
    },
    "status": { "enum": ["active", "draft", "review-only"] },
    "handWritten": { "type": "array", "items": { "type": "string" } },
    "portNotes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "side": {
      "type": "object",
      "required": ["what", "examples"],
      "properties": {
        "what": { "type": "string" },
        "examples": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    }
  }
}
