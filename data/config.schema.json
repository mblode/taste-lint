{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "smartQuotesAtBuild": {
      "type": "boolean"
    },
    "rules": {
      "description": "Extra rule directories, laid out like data/rules (domain folders of YAML rules). Paths resolve from the scan root; a leading ~ and $VARS expand, so a voice pack can live in $GHOSTWRITER_HOME.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skip": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unwrap": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "docTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "glob": {
            "type": "string"
          },
          "type": {
            "enum": [
              "tutorial",
              "howto",
              "reference",
              "explanation",
              "agent-instructions",
              "lesson",
              "marketing",
              "ui",
              "readme",
              "skill",
              "plan",
              "unknown"
            ]
          }
        },
        "required": ["glob", "type"]
      }
    },
    "tailwind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "taste-lint user configuration"
}
